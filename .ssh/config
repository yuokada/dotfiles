# ForwardAgent yes
# UseKeychain yes

Host *
  IgnoreUnknown UseKeychain
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m
  ServerAliveInterval 60
  ServerAliveCountMax 3
  ForwardAgent no
  UseKeychain yes
  AddKeysToAgent yes

Host bms
        Hostname b-ms.info
        port 22
        IdentityFile ~/.ssh/bms/id_rsa
        User yuokada
Host github.com
        IdentityFile ~/.ssh/vps/id_rsa
        IdentitiesOnly yes
        User git
Host gist.github.com
        IdentityFile ~/.ssh/vps/id_rsa
        IdentitiesOnly yes
        User git
